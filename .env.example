# Copy this file to .env and fill in real values. Never commit .env.
# For local `vercel dev`, you can instead run `vercel env pull` once these
# are set in the Vercel project dashboard.

# Supabase — create a project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then copy these from Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — create an account at https://resend.com. For testing you can send
# from their sandbox address below; for production, verify your own domain.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Priory Care Applications <onboarding@resend.dev>

# Meta WhatsApp Cloud API — create an app at https://developers.facebook.com,
# add the WhatsApp product. It gives you a free test number, phone_number_id
# and token to start with; NOTIFY_WHATSAPP_TO must first message that test
# number (or be added as a tester) before it can receive freeform messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFY_WHATSAPP_TO=
